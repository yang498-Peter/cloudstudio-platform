# CloudStudio local environment
# Copy this file to .env only if auto-detection is not enough.

# HTTP port for the local Node server.
PORT=8090

# Recommended for staging/demo: keep runtime data outside application code.
# Relative values resolve from web-uploader/; absolute paths are preferred on servers.
# CLOUDSTUDIO_DATA_DIR=/srv/cloudstudio-data

# Legacy alias still supported. Prefer CLOUDSTUDIO_DATA_DIR for new deploys.
# CLOUDSTUDIO_STORAGE_ROOT=/srv/cloudstudio-data

# Optional: hide runtime datasets from /api/clouds and the homepage without
# deleting their files. Separate entries with commas, semicolons, or new lines.
# Use either a dataset name or a scoped key such as gaussian::sample-scene.
# CLOUDSTUDIO_HIDDEN_DATASETS=

# Optional: explicit PotreeConverter path.
# Linux/macOS example:
# CONVERTER_PATH=/opt/cloudstudio/PotreeConverter/build-gcc/PotreeConverter
# Windows example:
# CONVERTER_PATH=D:\AI\tools\PotreeConverter\PotreeConverter.exe

# Optional: explicit Python used for export/grid scripts.
# Linux/macOS example:
# PYTHON_BIN=/opt/cloudstudio/web-uploader/.venv/bin/python
# Windows example:
# PYTHON_BIN=D:\AI\cloudstudio-server\web-uploader\.venv\Scripts\python.exe

# Optional: explicit system Python used for ZIP extraction and terrain jobs.
# Linux/macOS default is python3; Windows default is python.
# Windows example:
# PYTHON3_BIN=C:\Python312\python.exe
