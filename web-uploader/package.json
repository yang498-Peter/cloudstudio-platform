{
  "name": "potree-local-uploader",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "test:dxf-draw": "node --test tests/dxf-draw-topology.test.mjs",
    "test:floorplan": "node --test tests/job-result.test.mjs && python3 -m unittest tests.extract_floorplan_regression",
    "test:runtime-storage": "node --test tests/runtime-storage.test.mjs",
    "test:static-runtime": "node --test tests/static-runtime-exposure.test.mjs",
    "test:long-jobs": "node --test tests/long-job-state.test.mjs",
    "test:public-api-sanitize": "node --test tests/public-api-sanitize.test.mjs",
    "test:security-boundaries": "node --test tests/security-boundaries.test.mjs",
    "test:customer-safe": "node --test tests/customer-safe-v1.test.mjs",
    "test:gaussian": "node --test tests/gaussian-publish-state.test.mjs",
    "test:upload-security": "node --test tests/upload-security.test.mjs",
    "test:capabilities": "node --test tests/server-capabilities.test.mjs",
    "test:viewer-capabilities": "node --test tests/viewer-capability-toolbar.test.mjs",
    "test:photo-feature": "node --test tests/photo-feature.test.mjs",
    "test:volume": "node --test tests/volume-compute.test.mjs tests/volume-ui.test.mjs tests/volume-job.integration.test.mjs",
    "test:volume-report": "node --test tests/volume-report-visual.test.mjs",
    "test:viewer-smoke": "node --test tests/viewer-smoke.test.mjs",
    "test:viewer-volume": "node --test tests/viewer-volume-flow.test.mjs",
    "test:server-safe": "npm run test:runtime-storage && npm run test:static-runtime && npm run test:public-api-sanitize && npm run test:security-boundaries && npm run test:customer-safe && npm run test:gaussian && npm run test:upload-security && npm run test:capabilities && npm run test:viewer-capabilities && npm run test:photo-feature",
    "check:release": "npm run check:i18n && npm run check:public-release && npm run check:deploy-docs && npm run test:server-safe && npm run test:viewer-smoke",
    "check:i18n": "node scripts/check-i18n.js",
    "check:deploy-docs": "node scripts/check-deploy-docs.js",
    "check:public-release": "node scripts/check-public-release.js",
    "setup:local": "node ./setup-local-runner.cjs",
    "start:local": "node ./start-local-runner.cjs",
    "setup:local:win": "powershell -ExecutionPolicy Bypass -File .\\setup-local.ps1",
    "start:local:win": "powershell -ExecutionPolicy Bypass -File .\\start-local.ps1",
    "setup:local:unix": "bash ./setup-local.sh",
    "start:local:unix": "PYTHON_BIN=\"$PWD/.venv/bin/python\" PYTHON3_BIN=python3 node server.js"
  },
  "dependencies": {
    "@playcanvas/splat-transform": "^2.0.3",
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1"
  }
}
